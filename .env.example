# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secreto para firmar JWT de sesión (usuarios_crm)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Secreto compartido para endpoints internos llamados por n8n (no por usuarios logueados)
# Debe coincidir con el header X-Internal-Secret que envía el workflow de n8n hacia /api/push/send
INTERNAL_API_SECRET=

# Webhooks de n8n
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/crm-respuesta
N8N_UPLOAD_URL=https://n8n.example.com/webhook/crm-upload-imagen

# URL pública del webhook de n8n para subir imágenes directo desde el navegador
# (evita el límite de 4.5MB del body en las funciones serverless de Vercel).
# Debe ser accesible públicamente y el nodo "Respond to Webhook" debe permitir
# CORS para el origen del frontend (ver Access-Control-Allow-Origin).
NEXT_PUBLIC_N8N_UPLOAD_URL=https://n8n.example.com/webhook/crm-upload-imagen

# Web Push (VAPID) — generar con `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:soporte@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Brevo (email marketing) — opcional: si se omiten, se puede configurar desde
# Configuración > Integraciones en la app, y esos valores quedan en la tabla
# configuracion_integraciones en vez de en variables de entorno.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
